# Copy to .env and fill in. Values in .env override variables already set in your shell.

# LLM (Groq)
GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b
# The model that judges interview follow-ups in evals; keep it different from GROQ_MODEL.
# GROQ_JUDGE_MODEL=llama-3.3-70b-versatile

# Page origins allowed to call the HTTP API (the résumé upload) from another origin, comma separated.
# Only needed when the web page and this server are on different domains (web/.env VITE_API_URL).
# CORS_ORIGINS=https://your-page.example.com

# Speech to text and text to speech (Sarvam)
SARVAM_API_KEY=

# Calendar: "fake" keeps meetings in memory (no invite is sent); "google" uses the Google Calendar API.
CALENDAR_BACKEND=fake
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REFRESH_TOKEN=
# GOOGLE_CALENDAR_ID=primary

# Server port (default 3001)
# PORT=3001

# Retrieval: drop chunks scoring below this (between 0 and 1; default 0.65)
# RAG_MIN_SCORE=0.65

# Internal endpoint POST /internal/turn (text in, same agent, no speech). Leave unset to disable it.
# INTERNAL_API_KEY=

# Tracing (optional, LangSmith; name, email and title are masked before sending)
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=
